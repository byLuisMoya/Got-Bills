{
  "name": "got-bills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Control local de gastos e ingresos con graficos claros. 100% offline.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync android",
    "icons": "capacitor-assets generate --android",
    "apk": "npm run sync && cd android && ./gradlew assembleRelease",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "clean": "rm -rf dist android/app/build android/build",
    "test": "node test/periods.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.2",
    "@ionic/vue": "^8.4.1",
    "@ionic/vue-router": "^8.4.1",
    "chart.js": "^4.4.7",
    "ionicons": "^7.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^5.4.11"
  }
}
